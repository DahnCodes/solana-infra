# Copy this file to .env.local and change what you need.
# Every value has a safe default in src/lib/env.ts, so the app also runs without .env.local.
# NEXT_PUBLIC_ values are built into the browser bundle: never put secrets here.

# Where the app gets its data.
#   mock = in-memory sample data with a simulated clock (no wallet or validator needed)
#   live = the Breakglass program on the cluster below
NEXT_PUBLIC_DATA_MODE=mock

# Which Solana cluster to talk to in live mode: localnet, devnet or mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint for that cluster.
#   localnet: http://127.0.0.1:8899
#   devnet:   https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# The Breakglass program. Taken from docs/FRONTEND.md on the backend branch.
# `anchor keys sync` changes it per deployer, so update it at checkpoint B.
NEXT_PUBLIC_BREAKGLASS_PROGRAM_ID=AiMhNgDgXLQ68FhZrYczUiGxDxDeDxNFDTurqNFPP5kB

# The protocol Breakglass protects. The demo uses the repo's test_vault program.
NEXT_PUBLIC_PROTECTED_PROGRAM_ID=2orgNn8kfHVQi8EMxa86zntq8BbwQefXPtpZiQTfgPyn

# Token mint the demo vault holds. Filled in at checkpoint B; leave empty until then.
NEXT_PUBLIC_USDC_MINT=

# Off-chain monitor HTTP API (incidents, holds, events). See docs/FRONTEND.md section 7.
NEXT_PUBLIC_MONITOR_API_URL=http://127.0.0.1:8080
